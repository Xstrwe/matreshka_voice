diff --git a/engine/components/russianSpeech.h b/engine/components/russianSpeech.h
new file mode 100644
index 00000000..f9460296
--- /dev/null
+++ b/engine/components/russianSpeech.h
@@ -0,0 +1,210 @@
+/**
+ * File: russianSpeech.h
+ *
+ * Русская речь робота: числа словами, согласование с существительными и время.
+ * Всё здесь — встроенные функции, чтобы не добавлять новых .cpp в списки сборки.
+ */
+#ifndef __Engine_Components_RussianSpeech_H__
+#define __Engine_Components_RussianSpeech_H__
+
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace Anki {
+namespace Vector {
+namespace RussianSpeech {
+
+// Род для числительных «один/одна/одно», «два/две».
+enum class Gender { Masculine, Feminine, Neuter };
+
+// 0 — форма для 1 (градус), 1 — для 2-4 (градуса), 2 — для 5-20 и 0 (градусов).
+inline int PluralIndex(long n)
+{
+  n = std::labs(n);
+  const long n100 = n % 100;
+  const long n10 = n % 10;
+  if (n100 >= 11 && n100 <= 14) {
+    return 2;
+  }
+  if (n10 == 1) {
+    return 0;
+  }
+  if (n10 >= 2 && n10 <= 4) {
+    return 1;
+  }
+  return 2;
+}
+
+// Числа от 0 до 999 словами (без слова «ноль» для 0 — его добавляет NumberWords).
+inline std::string HundredsWords(long n, Gender g)
+{
+  static const char* kHundreds[] = {"", "сто", "двести", "триста", "четыреста", "пятьсот",
+                                    "шестьсот", "семьсот", "восемьсот", "девятьсот"};
+  static const char* kTens[] = {"", "", "двадцать", "тридцать", "сорок", "пятьдесят",
+                                "шестьдесят", "семьдесят", "восемьдесят", "девяносто"};
+  static const char* kTeens[] = {"десять", "одиннадцать", "двенадцать", "тринадцать", "четырнадцать",
+                                 "пятнадцать", "шестнадцать", "семнадцать", "восемнадцать", "девятнадцать"};
+  static const char* kUnits[] = {"", "один", "два", "три", "четыре", "пять",
+                                 "шесть", "семь", "восемь", "девять"};
+  std::vector<std::string> parts;
+  if (n / 100 > 0) {
+    parts.push_back(kHundreds[n / 100]);
+  }
+  const long rest = n % 100;
+  if (rest >= 10 && rest <= 19) {
+    parts.push_back(kTeens[rest - 10]);
+  } else {
+    if (rest / 10 > 0) {
+      parts.push_back(kTens[rest / 10]);
+    }
+    const long u = rest % 10;
+    if (u == 1) {
+      parts.push_back(g == Gender::Feminine ? "одна" : (g == Gender::Neuter ? "одно" : "один"));
+    } else if (u == 2) {
+      parts.push_back(g == Gender::Feminine ? "две" : "два");
+    } else if (u > 0) {
+      parts.push_back(kUnits[u]);
+    }
+  }
+  std::string out;
+  for (const auto& p : parts) {
+    if (!out.empty()) {
+      out += " ";
+    }
+    out += p;
+  }
+  return out;
+}
+
+// Целое число словами: -5 -> «минус пять», 21 (жен.) -> «двадцать одна», до 999 999.
+inline std::string NumberWords(long n, Gender g = Gender::Masculine)
+{
+  if (n == 0) {
+    return "ноль";
+  }
+  std::string out;
+  if (n < 0) {
+    out = "минус ";
+    n = -n;
+  }
+  if (n >= 1000000) {
+    return out + std::to_string(n);
+  }
+  const long thousands = n / 1000;
+  const long rest = n % 1000;
+  if (thousands > 0) {
+    static const char* kThousand[] = {"тысяча", "тысячи", "тысяч"};
+    out += HundredsWords(thousands, Gender::Feminine) + " " + kThousand[PluralIndex(thousands)];
+    if (rest > 0) {
+      out += " ";
+    }
+  }
+  if (rest > 0) {
+    out += HundredsWords(rest, g);
+  }
+  return out;
+}
+
+// Число со словом в нужной форме: (3, градус/градуса/градусов) -> «три градуса».
+inline std::string CountWords(long n, Gender g, const std::string& one, const std::string& few, const std::string& many)
+{
+  const std::string* forms[] = {&one, &few, &many};
+  return NumberWords(n, g) + " " + *forms[PluralIndex(n)];
+}
+
+// Строка — целое число (с необязательным минусом)?
+inline bool ParseInt(const std::string& s, long& out)
+{
+  if (s.empty()) {
+    return false;
+  }
+  size_t i = (s[0] == '-') ? 1 : 0;
+  if (i == s.size()) {
+    return false;
+  }
+  for (size_t j = i; j < s.size(); j++) {
+    if (s[j] < '0' || s[j] > '9') {
+      return false;
+    }
+  }
+  out = std::strtol(s.c_str(), nullptr, 10);
+  return true;
+}
+
+// Время по-русски: «Сейчас час ноль пять», «Сейчас двенадцать пятьдесят семь»,
+// «Сейчас ровно три».
+inline std::string TimeWords(int hour, int minute)
+{
+  std::string h = (hour == 1) ? "час" : NumberWords(hour, Gender::Masculine);
+  if (minute == 0) {
+    return "Сейчас ровно " + h + ".";
+  }
+  std::string m = NumberWords(minute, Gender::Feminine);
+  if (minute < 10) {
+    m = "ноль " + m;
+  }
+  return "Сейчас " + h + " " + m + ".";
+}
+
+// Подставляет аргументы в русский шаблон.
+//   {0}            — аргумент как есть; целое число превращается в слова;
+//   {0#m:a|b|c}    — число словами с согласованным словом (m/f/n — род числительного).
+inline std::string Format(const std::string& tmpl, const std::vector<std::string>& args)
+{
+  std::string out;
+  size_t i = 0;
+  while (i < tmpl.size()) {
+    if (tmpl[i] == '{') {
+      const size_t close = tmpl.find('}', i);
+      if (close != std::string::npos) {
+        const std::string spec = tmpl.substr(i + 1, close - i - 1);
+        const size_t hash = spec.find('#');
+        const std::string idxStr = spec.substr(0, hash);
+        long idx = -1;
+        if (ParseInt(idxStr, idx) && idx >= 0 && idx < static_cast<long>(args.size())) {
+          const std::string& arg = args[static_cast<size_t>(idx)];
+          long n = 0;
+          const bool isNum = ParseInt(arg, n);
+          if (hash == std::string::npos) {
+            out += isNum ? NumberWords(n) : arg;
+          } else {
+            // Формат «g:one|few|many».
+            const std::string rest = spec.substr(hash + 1);
+            Gender g = Gender::Masculine;
+            std::string forms = rest;
+            if (rest.size() > 2 && rest[1] == ':') {
+              g = (rest[0] == 'f') ? Gender::Feminine : (rest[0] == 'n' ? Gender::Neuter : Gender::Masculine);
+              forms = rest.substr(2);
+            }
+            std::vector<std::string> f;
+            size_t start = 0;
+            while (true) {
+              const size_t bar = forms.find('|', start);
+              f.push_back(forms.substr(start, bar - start));
+              if (bar == std::string::npos) {
+                break;
+              }
+              start = bar + 1;
+            }
+            while (f.size() < 3) {
+              f.push_back(f.back());
+            }
+            out += isNum ? CountWords(n, g, f[0], f[1], f[2]) : (arg + " " + f[2]);
+          }
+          i = close + 1;
+          continue;
+        }
+      }
+    }
+    out += tmpl[i];
+    i++;
+  }
+  return out;
+}
+
+} // namespace RussianSpeech
+} // namespace Vector
+} // namespace Anki
+
+#endif
