+// ---------------------------------------------------------------------------------------------
+// Русский голос для фраз робота (matreshka_voice). Если есть файл kRemoteTtsUrlPath с адресом
+// вида http://192.168.8.127:8080/robot_tts, текст фразы уходит на wire-pod, тот переводит его
+// на русский и озвучивает. Ответ — сырой PCM 16 кГц, моно, 16 бит. При любой ошибке
+// (нет файла, сеть, таймаут, не 200) робот говорит штатным английским голосом Acapela.
+// Выключить: удалить файл (перезапуск не нужен, файл читается перед каждой фразой).
+// ---------------------------------------------------------------------------------------------
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
