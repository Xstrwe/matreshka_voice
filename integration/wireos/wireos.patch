+namespace {
+  constexpr const char* kRemoteTtsUrlPath =
+    "/data/data/com.anki.victor/persistent/matreshka_voice/tts_url";
+  constexpr int kRemoteTtsConnectTimeout_ms = 1500;
+  constexpr int kRemoteTtsReadTimeout_s = 20;
+  constexpr int kRemoteTtsSampleRate = 16000;
+
+  // Процентное кодирование текста для строки запроса.
+  std::string UrlEncode(const std::string& in)
+  {
+    static const char* hex = "0123456789ABCDEF";
+    std::string out;
+    for (unsigned char c : in) {
+      if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
+        out += static_cast<char>(c);
+      } else {
+        out += '%';
+        out += hex[c >> 4];
+        out += hex[c & 15];
+      }
+    }
+    return out;
+  }
+
+  // Разбирает http://host:port/path. Только http, без TLS: wire-pod в той же локальной сети.
+  bool ParseUrl(const std::string& url, std::string& host, int& port, std::string& path)
+  {
+    const std::string prefix = "http://";
+    if (url.compare(0, prefix.size(), prefix) != 0) {
+      return false;
+    }
+    const std::string rest = url.substr(prefix.size());
+    const size_t slash = rest.find('/');
+    const std::string hostport = rest.substr(0, slash);
+    path = (slash == std::string::npos) ? "/" : rest.substr(slash);
+    const size_t colon = hostport.find(':');
+    host = hostport.substr(0, colon);
+    port = (colon == std::string::npos) ? 80 : atoi(hostport.c_str() + colon + 1);
+    return !host.empty() && port > 0 && port < 65536;
+  }
+
+  // Подключение с таймаутом: неблокирующий connect + select.
+  int ConnectWithTimeout(const std::string& host, int port)
+  {
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    struct addrinfo* res = nullptr;
+    if (getaddrinfo(host.c_str(), std::to_string(port).c_str(), &hints, &res) != 0 || res == nullptr) {
+      return -1;
+    }
+    int fd = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
+    if (fd < 0) {
+      freeaddrinfo(res);
+      return -1;
+    }
+    const int flags = fcntl(fd, F_GETFL, 0);
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+    int rc = connect(fd, res->ai_addr, res->ai_addrlen);
+    freeaddrinfo(res);
+    if (rc < 0 && errno != EINPROGRESS) {
+      close(fd);
+      return -1;
+    }
+    if (rc < 0) {
+      fd_set wfds;
+      FD_ZERO(&wfds);
+      FD_SET(fd, &wfds);
+      struct timeval tv { kRemoteTtsConnectTimeout_ms / 1000, (kRemoteTtsConnectTimeout_ms % 1000) * 1000 };
+      int err = 0;
+      socklen_t len = sizeof(err);
+      if (select(fd + 1, nullptr, &wfds, nullptr, &tv) <= 0 ||
+          getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len) != 0 || err != 0) {
+        close(fd);
+        return -1;
+      }
+    }
+    fcntl(fd, F_SETFL, flags);
+    struct timeval rtv { kRemoteTtsReadTimeout_s, 0 };
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &rtv, sizeof(rtv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &rtv, sizeof(rtv));
+    return fd;
+  }
+
+  // Запрашивает озвучку у wire-pod. true и samples (16 кГц), если всё получилось.
+  bool FetchRemoteTts(const std::string& text, std::vector<int16_t>& samples)
+  {
+    std::ifstream f(kRemoteTtsUrlPath);
+    std::string url;
+    if (!f.is_open() || !std::getline(f, url)) {
+      return false;
+    }
+    while (!url.empty() && isspace(static_cast<unsigned char>(url.back()))) {
+      url.pop_back();
+    }
+    std::string host, path;
+    int port = 0;
+    if (!ParseUrl(url, host, port, path)) {
+      LOG_WARNING("TextToSpeechProvider.RemoteTts", "bad url in %s", kRemoteTtsUrlPath);
+      return false;
+    }
+    const int fd = ConnectWithTimeout(host, port);
+    if (fd < 0) {
+      LOG_WARNING("TextToSpeechProvider.RemoteTts", "connect failed, using stock voice");
+      return false;
+    }
+    const std::string req = "GET " + path + "?text=" + UrlEncode(text) + " HTTP/1.0\r\nHost: " + host +
+                            "\r\nConnection: close\r\n\r\n";
+    if (send(fd, req.data(), req.size(), 0) != static_cast<ssize_t>(req.size())) {
+      close(fd);
+      return false;
+    }
+    std::string resp;
+    char buf[8192];
+    ssize_t n;
+    while ((n = recv(fd, buf, sizeof(buf), 0)) > 0) {
+      resp.append(buf, static_cast<size_t>(n));
+      if (resp.size() > 16 * 1024 * 1024) {
+        break;
+      }
+    }
+    close(fd);
+    const size_t hdrEnd = resp.find("\r\n\r\n");
+    const bool ok200 = (resp.compare(0, 12, "HTTP/1.1 200") == 0) || (resp.compare(0, 12, "HTTP/1.0 200") == 0);
+    if (n < 0 || hdrEnd == std::string::npos || !ok200) {
+      LOG_WARNING("TextToSpeechProvider.RemoteTts", "no audio from wire-pod, using stock voice");
+      return false;
+    }
+    const size_t bodyLen = (resp.size() - hdrEnd - 4) / 2;
+    if (bodyLen < 160) {
+      return false;
+    }
+    samples.resize(bodyLen);
+    memcpy(samples.data(), resp.data() + hdrEnd + 4, bodyLen * 2);
+    return true;
+  }
+
+  // Линейная передискретизация 16 кГц -> частота голоса Acapela (обычно 22050 Гц),
+  // чтобы дальше по цепочке звук ничем не отличался от штатного.
+  void Resample(const std::vector<int16_t>& in, int inRate, int outRate, std::vector<int16_t>& out)
+  {
+    if (inRate == outRate || outRate <= 0 || in.empty()) {
+      out = in;
+      return;
+    }
+    const size_t outLen = static_cast<size_t>(static_cast<double>(in.size()) * outRate / inRate);
+    out.resize(outLen);
+    for (size_t i = 0; i < outLen; i++) {
+      const double pos = static_cast<double>(i) * inRate / outRate;
+      const size_t i0 = std::min(static_cast<size_t>(pos), in.size() - 1);
+      const size_t i1 = std::min(i0 + 1, in.size() - 1);
+      const double frac = pos - static_cast<double>(i0);
+      out[i] = static_cast<int16_t>(in[i0] * (1.0 - frac) + in[i1] * frac);
+    }
+  }
+}
